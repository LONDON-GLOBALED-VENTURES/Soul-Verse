<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Login tokens are encrypted with a key that never leaves this
     device, so a restored copy can't be decrypted: leave them out. Everything
     else (favourites, reminder settings) is still backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    </device-transfer>
</data-extraction-rules>
