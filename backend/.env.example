NODE_ENV=development
PORT=3000
CORS_ORIGIN=*
# Base URL for template/mood images (e.g. your CDN). Leave empty in dev to serve from /static.
ASSET_BASE_URL=

# 1. Google OAuth Client ID (from Google Cloud Console)
# This is required for verifying real Google Sign-In tokens on the backend
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# 2. JWT Secrets (Change these in production to secure random strings)
JWT_SECRET=your-random-32-character-secret-key
JWT_REFRESH_SECRET=your-random-32-character-refresh-secret-key