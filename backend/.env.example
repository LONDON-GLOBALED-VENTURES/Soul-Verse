# development | production. If unset, the server runs as production.
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*
# Base URL for template/mood images (e.g. your CDN). Leave empty in dev to serve from /static.
ASSET_BASE_URL=

# Email shown on the public /delete-account page.
SUPPORT_EMAIL=support@example.com

# Moderator key for /api/admin (review reported prayers). Leave empty to turn those routes off.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_KEY=

# QA only: set to false on a STAGING backend to unlock all Premium features in the app.
# Never on production: it makes Premium free for every user of this backend.
BILLING_ENABLED=true

# RevenueCat webhook (POST /api/billing/revenuecat-webhook) keeps users' subscription in sync.
# Use the same value as the webhook's "Authorization header value" in RevenueCat.
# Leave empty to turn the webhook off. Generate one like ADMIN_API_KEY above.
REVENUECAT_WEBHOOK_SECRET=

# 1. Google OAuth Client ID (from Google Cloud Console)
# This is required for verifying real Google Sign-In tokens on the backend
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# 2. JWT Secrets: two different random values, at least 32 characters each.
# Required in production (the server won't start without them). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your-random-32-character-secret-key
JWT_REFRESH_SECRET=your-random-32-character-refresh-secret-key

# 3. Development only: accept fake "mock-google-token:email:name:id" sign-ins
# (e.g. for curl testing). Ignored unless NODE_ENV=development.
# ALLOW_MOCK_GOOGLE_AUTH=true


DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-....aws.neon.tech/neondb?sslmode=verify-full"